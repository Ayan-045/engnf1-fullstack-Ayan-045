# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL="https://your-app-url.example.com"
DISABLE_HMR=false

# PostgreSQL / Cloud SQL (App Runtime User)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="resolvegrid_db"
SQL_USER="resolvegrid_app_user"
SQL_PASSWORD="MY_SQL_APP_PASSWORD"

# PostgreSQL / Cloud SQL (Schema Migration Admin User for Drizzle Kit)
SQL_ADMIN_USER="resolvegrid_admin_user"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# Admin Access & Auth Overrides
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSCODE="MY_ADMIN_PASSCODE"

# Gemini API (Server-Side)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Test & Benchmark Scripts
TEST_BASE_URL="http://127.0.0.1:3000"
